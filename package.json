{
  "name": "nippon-drive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "audit:catalog": "tsx scripts/auditCatalog.ts",
    "check": "npm run lint && npm run build && npm run audit:catalog && npm run audit:branding && npm run audit:variants",
    "test:smoke": "playwright test",
    "audit:branding": "tsx scripts/auditProjectBranding.ts",
    "import:vehicles": "tsx scripts/importVehicleVariants.ts --write",
    "audit:variants": "tsx scripts/importVehicleVariants.ts --check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/screen-orientation": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@capacitor/cli": "^8.5.3"
  }
}
